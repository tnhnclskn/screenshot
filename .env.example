# Port
PORT=3000

# API Güvenliği (Header ile X-API-Key veya Bearer token kontrolü)
# Boş bırakılırsa auth check bypass edilir (public mode)
API_KEY=your_secret_api_key_here

# Ortam
NODE_ENV=development

# Sayfa ve element bekleme zaman aşımı (milisaniye)
DEFAULT_TIMEOUT=30000

# Puppeteer Headless Modu (true / false)
PUPPETEER_HEADLESS=true
